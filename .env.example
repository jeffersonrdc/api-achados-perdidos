SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=3306
DB_NAME=achados_perdidos
DB_URL=jdbc:mysql://localhost:3306/achados_perdidos?useSSL=false&serverTimezone=UTC&tinyInt1isBit=false
DB_USERNAME=root
DB_PASSWORD=

# OBRIGATÓRIOS: a aplicação não sobe sem estes segredos (mín. 32 caracteres, valores próprios).
# Gere com: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=2592000000
RESOURCE_ID_SECRET=

# Documentação da API: mantenha false em produção.
SPRINGDOC_ENABLED=false

# Rate limiting do login (força-bruta).
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_IP_PER_MINUTE=30
LOGIN_RATE_LIMIT_ACCOUNT_ATTEMPTS=5
LOGIN_RATE_LIMIT_ACCOUNT_WINDOW_MINUTES=15

CORS_ENABLED=true
# DEV (padrão abaixo). Em PRODUÇÃO, troque pelos domínios REAIS do painel e do portal
# público e esvazie os patterns de localhost:
#   CORS_ALLOWED_ORIGINS=https://painel_rockinrio.mastersdevs.com.br,https://app_rockinrio.mastersdevs.com.br
#   CORS_ALLOWED_ORIGIN_PATTERNS=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4200,http://localhost:4300,http://127.0.0.1:4200
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
CORS_ALLOW_CREDENTIALS=true

APP_ARQUIVOS_DIR=./arquivos
