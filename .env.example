SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=3306
DB_NAME=achados_perdidos
DB_URL=jdbc:mysql://localhost:3306/achados_perdidos?useSSL=false&serverTimezone=America/Sao_Paulo&tinyInt1isBit=false
DB_USERNAME=root
DB_PASSWORD=

# OBRIGATÓRIOS: a aplicação não sobe sem estes segredos (mín. 32 caracteres, valores próprios).
# Gere com: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=2592000000
RESOURCE_ID_SECRET=

# Documentação da API: mantenha false em produção.
SPRINGDOC_ENABLED=false

# Rate limiting do login (força-bruta).
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_IP_PER_MINUTE=30
LOGIN_RATE_LIMIT_ACCOUNT_ATTEMPTS=5
LOGIN_RATE_LIMIT_ACCOUNT_WINDOW_MINUTES=15

CORS_ENABLED=true
# DEV (padrão abaixo). Em PRODUÇÃO, troque pelos domínios REAIS do painel e do portal
# público e esvazie os patterns de localhost:
#   CORS_ALLOWED_ORIGINS=https://painel_rockinrio.mastersdevs.com.br,https://app_rockinrio.mastersdevs.com.br
#   CORS_ALLOWED_ORIGIN_PATTERNS=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4200,http://localhost:4300,http://127.0.0.1:4200
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
CORS_ALLOW_CREDENTIALS=true

APP_ARQUIVOS_DIR=./arquivos

# Armazenamento S3 (opcional). O provedor padrão (LOCAL|S3) é definido em /configuracoes.
# Credenciais: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY ou role IAM.
APP_S3_ENABLED=true
APP_S3_BUCKET=
APP_S3_REGION=us-east-1
APP_S3_PREFIX=
# Endpoint customizado (MinIO/LocalStack). Vazio = AWS.
APP_S3_ENDPOINT=
APP_S3_PATH_STYLE=false
MULTIPART_MAX_REQUEST_SIZE=30MB

# ---------------------------------------------------------------------------
# CDN (CloudFront) — só faz sentido no ambiente em que a API fica ATRÁS da CDN.
# ---------------------------------------------------------------------------
# Header com o IP real do visitante. Atrás do CloudFront, o X-Forwarded-For chega
# como "<viewer>, <edge>" e o Tomcat para no IP público do edge — todos os usuários
# passariam a dividir o mesmo balde de rate limit e a auditoria gravaria o IP errado.
# Produção AWS: CloudFront-Viewer-Address (precisa estar na origin request policy).
# Vazio = usa o IP da conexão (ambiente sem CDN).
# ATENÇÃO: só preencha se a origem for alcançável APENAS através da CDN.
CLIENT_IP_TRUSTED_HEADER=

# Cache positivo nos GETs públicos do portal. Deixe true onde há CDN.
# Use false em ambiente SEM CDN (ex.: DEV) para voltar tudo a no-store: sem isso, o
# cache do NAVEGADOR atrasa em até 5 min ver no portal um cadastro alterado no painel.
# Também serve de alavanca de emergência em produção, sem deploy de código.
PUBLIC_JSON_CACHE_ENABLED=true

# TTL (segundos) das fotos públicas do portal na CDN — /portal/arquivos/{id}/download
# e /thumbnail. Os bytes de um ID nunca mudam, mas o arquivo pode deixar de ser público
# (exclusão, moderação, item reclamado) sem que a CDN saiba. Enquanto não houver
# invalidação automática no CloudFront, reduzir este valor é o controle disponível.
ARQUIVO_PUBLICO_MAX_AGE=86400
