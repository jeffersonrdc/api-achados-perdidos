spring.datasource.url=jdbc:mysql://localhost:3306/achados_perdidos?useSSL=false&serverTimezone=UTC&tinyInt1isBit=false
spring.datasource.username=root
spring.datasource.password=

# Copie para application-local.properties na raiz do projeto.
# Defina JWT_SECRET e RESOURCE_ID_SECRET no .env (ou aqui, com valores próprios >= 32 chars).
app.jwt.secret=${JWT_SECRET}
app.resource-id.secret=${RESOURCE_ID_SECRET}
